# Copy this file to .env and fill in the values below.
# .env is gitignored — never commit real secrets.

# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only this email is allowed to sign in. Leave blank only for local dev
# testing — never leave it blank once this is deployed anywhere reachable
# by anyone but you.
ALLOWED_EMAIL=varun@twenty20sys.com

# Random long string used to sign session cookies. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=

# Where the browser gets redirected after a successful Google sign-in.
# Must use 'localhost' (not 127.0.0.1) to match the API host, or the
# SameSite=Lax session cookie won't be sent on fetch — see auth.py.
FRONTEND_URL=http://localhost:5757/app.html#/app

# Comma-separated origins allowed to make credentialed API calls.
ALLOWED_ORIGINS=http://localhost:5757,http://127.0.0.1:5757

# Optional — Tier 3 LLM categorization fallback (backend/llm_categorize.py).
# Get a free key at https://console.groq.com/keys. Leave blank to skip
# this tier; transactions that rules + contacts can't resolve just stay
# Uncategorized for manual tagging.
GROQ_API_KEY=
